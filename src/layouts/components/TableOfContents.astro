---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  title?: string;
  minDepth?: number;
  maxDepth?: number;
  indentStep?: number;
  scrollOffset?: number;
  bottomMargin?: string;
  class?: string;
}

const {
  headings,
  title = "On this page",
  minDepth = 2,
  maxDepth = 4,
  indentStep = 0.875,
  scrollOffset = 96,
  bottomMargin = "0%",
  class: className = "",
} = Astro.props;

const toc = headings.filter((h) => h.depth >= minDepth && h.depth <= maxDepth);
---

{
  toc.length > 0 && (
    <nav
      class:list={["toc", className]}
      aria-label="Table of contents"
      data-toc-root
      data-scroll-offset={scrollOffset}
      data-bottom-margin={bottomMargin}
    >
      <p class="toc-title">{title}</p>
      <ul class="toc-list" data-toc-list>
        {toc.map((heading) => (
          <li
            class="toc-item"
            data-depth={heading.depth}
            style={`--toc-indent:${(heading.depth - minDepth) * indentStep}rem`}
          >
            <a
              class="toc-link"
              href={`#${heading.slug}`}
              data-toc-link={heading.slug}
            >
              <span class="toc-marker" aria-hidden="true" />
              <span class="toc-text">{heading.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  const initToc = () => {
    const root = document.querySelector<HTMLElement>("[data-toc-root]");
    const list = root?.querySelector<HTMLElement>("[data-toc-list]");
    if (!root || !list) return;

    const scrollOffset = Number(root.dataset.scrollOffset) || 96;
    const bottomMargin = root.dataset.bottomMargin || "0%";

    const links = Array.from(
      list.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
    );
    const slugs = links
      .map((l) => l.dataset.tocLink)
      .filter((s): s is string => Boolean(s));

    const headings = slugs
      .map((slug) => document.getElementById(slug))
      .filter((el): el is HTMLElement => Boolean(el));

    if (!headings.length) return;

    const visible = new Set<string>();

    const setActive = () => {
      let active = visible;
      if (active.size === 0) {
        // fallback: nearest heading above viewport top
        let current: string | null = null;
        for (const h of headings) {
          const top = h.getBoundingClientRect().top;
          if (top - scrollOffset - 24 <= 0) current = h.id;
          else break;
        }
        active = new Set(current ? [current] : []);
      }
      links.forEach((link) => {
        const slug = link.dataset.tocLink;
        link.classList.toggle("is-active", slug ? active.has(slug) : false);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const id = entry.target.id;
          if (entry.isIntersecting) visible.add(id);
          else visible.delete(id);
        }
        setActive();
      },
      {
        rootMargin: `-${scrollOffset}px 0px ${bottomMargin ? `-${bottomMargin}` : "0px"} 0px`,
        threshold: 0,
      },
    );

    headings.forEach((h) => observer.observe(h));

    setActive();
  };

  initToc();
  document.addEventListener("astro:page-load", initToc);
</script>
